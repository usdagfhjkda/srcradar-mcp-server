{
  "tools": [
    {
      "name": "stage_file",
      "path": "_stage_file",
      "auth": "e1-confirmed",
      "_handler": "stage_file",
      "_doc": "Write client-supplied bytes (stdin | base64 | file_path+base64) to ~/.cache/srcradar-mcp/staged/<16-hex>.<ext>; returns staged_path + upload_id for downstream tools (e.g. add_business -s). Promoted to e1-confirmed so Hermes trust:untrusted surfaces the native approval gate (stage writes to disk)."
    },
    {
      "name": "stage_dir",
      "path": "_stage_dir",
      "auth": "e1-confirmed",
      "_handler": "stage_dir",
      "_doc": "Materialise a tar.gz (base64) or entries-list into ~/.cache/srcradar-mcp/staged/<16-hex>/; returns staged_dir + upload_id for downstream tools (e.g. add_business -i). Promoted to e1-confirmed so Hermes trust:untrusted surfaces the native approval gate (stage writes to disk)."
    },
    {
      "name": "db.read_business_summary",
      "path": "db/read_business_summary.py",
      "auth": "none"
    },
